# ===================================================================
# CampusIQ Backend - Environment Variables Template
# Copy this file to '.env' inside the backend directory:
#   Windows CMD:        copy .env.example .env
#   Linux/macOS/Bash:   cp .env.example .env
# ===================================================================

PORT=5000
NODE_ENV=development

# MySQL / XAMPP Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusiq_db

# Cloud MySQL (TiDB Cloud / Aiven / PlanetScale) requires TLS.
# Leave blank/false for local XAMPP.
DB_SSL=false
# Set true only if the provider uses a self-signed cert
DB_SSL_REJECT_UNAUTHORIZED=true
# Set true when the provider pre-creates the database and blocks CREATE DATABASE
DB_SKIP_CREATE=false

# Authentication
JWT_SECRET=campusiq_jwt_secure_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
# Comma-separated allowlist. Add the deployed frontend URL in production, e.g.
# CLIENT_URL=http://localhost:5173,https://campusiq.vercel.app
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
ALLOW_VERCEL_PREVIEWS=false
# Set true to serve frontend/dist from this same Express service (single URL)
SERVE_CLIENT=false

# AI Service Configuration
GEMINI_API_KEY=
