# ===================================================================
# CampusIQ .gitignore
# Secure Configuration for Public & Private Repositories
# ===================================================================

# -------------------------------------------------------------------
# 1. Environment & Sensitive Data (NEVER COMMIT)
# -------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
*.env
*.env.local

# Explicitly KEEP .env.example template files tracked for team members
!*.env.example
!.env.example
!backend/.env.example
!frontend/.env.example

# -------------------------------------------------------------------
# 2. Dependencies
# -------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# -------------------------------------------------------------------
# 3. Production Build Outputs
# -------------------------------------------------------------------
dist/
dist-ssr/
frontend/dist/
frontend/build/
build/
*.local

# -------------------------------------------------------------------
# 4. Logs & Debugging
# -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------------------
# 5. Editor, OS & System Temp Files
# -------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.tmp
*.temp
